
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": false,

    "resolveJsonModule": true
  },

  "include": [
    "app.ts",
    "server.ts",
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}

